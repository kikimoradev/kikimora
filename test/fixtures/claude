#!/usr/bin/env node

import { spawn } from "node:child_process";
import { writeFileSync } from "node:fs";

const modelIndex = process.argv.indexOf("--model");
const model = modelIndex >= 0 ? process.argv[modelIndex + 1] : undefined;
const suffix = model ? `_${model.toUpperCase()}` : "";

function pick(name) {
  return process.env[name + suffix] ?? process.env[name];
}

const mode = pick("FAKE_CLAUDE_MODE") ?? "ok";
const promptOut = pick("FAKE_CLAUDE_PROMPT_OUT");
const argsOut = pick("FAKE_CLAUDE_ARGS_OUT");
const resultText = pick("FAKE_CLAUDE_RESULT_TEXT");
const sessionId = pick("FAKE_CLAUDE_SESSION_ID") ?? "sess-1";
const envOut = pick("FAKE_CLAUDE_ENV_OUT");
const treeOut = pick("FAKE_CLAUDE_TREE_OUT");

if (argsOut) writeFileSync(argsOut, JSON.stringify(process.argv.slice(2)));
if (envOut) {
  const kikimoraEnv = Object.fromEntries(
    Object.entries(process.env).filter(([key]) => key.startsWith("KIKIMORA_")),
  );
  writeFileSync(envOut, JSON.stringify({ pid: process.pid, env: kikimoraEnv }));
}

function emit(event) {
  process.stdout.write(`${JSON.stringify(event)}\n`);
}

if (process.argv[2] === "--version") {
  process.stdout.write(`${process.env.FAKE_CLAUDE_VERSION ?? "2.1.268"} (Claude Code)\n`);
  process.exit(0);
}

if (process.argv[2] === "auth" && process.argv[3] === "status") {
  const auth = process.env.FAKE_CLAUDE_AUTH ?? "logged_in";
  if (auth === "unsupported") {
    process.stderr.write("error: unknown command 'auth'\n");
    process.exit(1);
  } else if (auth === "hang") {
    setInterval(() => {}, 1000);
  } else {
    const loggedIn = auth === "logged_in";
    emit({
      loggedIn,
      authMethod: loggedIn ? "claude.ai" : "none",
      apiProvider: "firstParty",
    });
    process.exit(loggedIn ? 0 : 1);
  }
}

function emitAuthFailure(text, withRetries) {
  emit({
    type: "system",
    subtype: "init",
    model: model ?? "haiku",
    session_id: sessionId,
    tools: ["Read", "Bash"],
  });
  if (withRetries) {
    for (const attempt of [1, 2]) {
      emit({
        type: "system",
        subtype: "api_retry",
        attempt,
        max_retries: 10,
        retry_delay_ms: 531,
        error_status: 401,
        error: "authentication_failed",
        session_id: sessionId,
      });
    }
  }
  emit({ type: "assistant", message: { content: [{ type: "text", text }] } });
  emit({
    type: "result",
    subtype: "success",
    is_error: true,
    result: text,
    terminal_reason: "api_error",
    num_turns: 1,
    total_cost_usd: 0,
    session_id: sessionId,
  });
}

function emitInit() {
  emit({
    type: "system",
    subtype: "init",
    model: model ?? "haiku",
    session_id: sessionId,
    tools: ["Read", "Bash"],
  });
}

function emitOutcome(isError) {
  emit({
    type: "assistant",
    message: { content: [{ type: "text", text: "Worker output" }] },
  });
  emit({
    type: "result",
    is_error: isError,
    total_cost_usd: 0.0123,
    num_turns: 2,
    session_id: sessionId,
    ...(resultText !== undefined ? { result: resultText } : {}),
  });
}

function emitOk(isError) {
  emitInit();
  emitOutcome(isError);
}

const HOLD = "setInterval(() => {}, 1000);";
const IGNORE_SIGTERM = 'process.on("SIGTERM", () => {});';

function spawnNode(source, stdout) {
  return spawn(process.execPath, ["-e", source], {
    stdio: ["ignore", stdout, "ignore"],
    windowsHide: true,
  });
}

function readPid(child) {
  return new Promise((resolve) => {
    let buffer = "";
    child.stdout.on("data", (chunk) => {
      buffer += chunk;
      const newline = buffer.indexOf("\n");
      if (newline !== -1) resolve(Number(buffer.slice(0, newline)));
    });
  });
}

function spawnDescendant(prefix, exitAfterSpawn) {
  const descendant = `const c = require("node:child_process").spawn(process.execPath, ["-e", ${JSON.stringify(`${IGNORE_SIGTERM}${HOLD}`)}], { stdio: "ignore", windowsHide: true });`;
  const report = `process.stdout.write(c.pid + "\\n", () => { ${exitAfterSpawn ? "process.exit(0);" : ""} });`;
  return spawnNode(`${prefix}${descendant}${report}${exitAfterSpawn ? "" : HOLD}`, "pipe");
}

async function spawnTree() {
  const intermediate = spawnDescendant(IGNORE_SIGTERM, false);
  const parentOfOrphan = spawnDescendant("", true);
  const [grandchild, orphan] = await Promise.all([
    readPid(intermediate),
    readPid(parentOfOrphan),
  ]);
  writeFileSync(
    treeOut,
    JSON.stringify({ attached: [intermediate.pid, grandchild], orphaned: [orphan] }),
  );
}

let stdin = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk) => {
  stdin += chunk;
});
process.stdin.on("end", () => {
  if (promptOut) writeFileSync(promptOut, stdin);
  run();
});

function run() {
  switch (mode) {
    case "ok":
      emitOk(false);
      process.exit(0);
      break;
    case "error_result":
      emitOk(true);
      process.exit(0);
      break;
    case "exit_nonzero":
      process.stderr.write("something went wrong\n");
      process.exit(2);
      break;
    case "auth_error":
      emitAuthFailure(
        "Failed to authenticate. API Error: 401 OAuth access token is invalid.",
        true,
      );
      process.exit(1);
      break;
    case "not_logged_in":
      emitAuthFailure("Not logged in · Please run /login", false);
      process.exit(1);
      break;
    case "hang":
      process.on("SIGTERM", () => process.exit(143));
      setInterval(() => {}, 1000);
      break;
    case "slow":
      emitInit();
      setTimeout(() => {
        emitOutcome(false);
        process.exit(0);
      }, Number(pick("FAKE_CLAUDE_DELAY_MS") ?? "1000"));
      break;
    case "hang_with_tree":
      process.on("SIGTERM", () => process.exit(143));
      setInterval(() => {}, 1000);
      void spawnTree().then(emitInit);
      break;
    case "killed_after_init":
      emitInit();
      process.stdout.write("", () => process.kill(process.pid, "SIGKILL"));
      break;
    case "hang_after_init":
      emitInit();
      process.on("SIGTERM", () => process.exit(143));
      setInterval(() => {}, 1000);
      break;
    default:
      process.stderr.write(`unknown FAKE_CLAUDE_MODE=${mode}\n`);
      process.exit(1);
  }
}
